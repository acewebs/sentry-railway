# Sentry on Railway (lean, errors-only) — environment variables
#
# Almost everything is auto-generated or referenced on Railway — see the ${{ ... }}
# hints. The only value that can't be auto-generated is the relay keypair (ship one
# as a template default, or paste one). Static peer hostnames use Railway private
# DNS (<service-name>.railway.internal) and need no changes unless you rename a
# service. See docs/RAILWAY.md for which service needs what.

# ---- Image tags (optional; the Dockerfiles already pin :26.7.0) -------------
# Set as a service variable to override the build ARG and pin a specific tag/digest.
# SENTRY_IMAGE=ghcr.io/getsentry/sentry:26.7.0
# SNUBA_IMAGE=ghcr.io/getsentry/snuba:26.7.0
# RELAY_IMAGE=ghcr.io/getsentry/relay:26.7.0
# TASKBROKER_IMAGE=ghcr.io/getsentry/taskbroker:26.7.0

# ---- Auto-generated secrets (use Railway's secret() — no manual value) -------
# Django secret key, shared by sentry-web (source) + sentry-workers (reference):
#   sentry-web:      SENTRY_SYSTEM_SECRET_KEY=${{ secret(50) }}
#   sentry-workers:  SENTRY_SYSTEM_SECRET_KEY=${{ sentry-web.SENTRY_SYSTEM_SECRET_KEY }}
SENTRY_SYSTEM_SECRET_KEY=${{ secret(50) }}
# ClickHouse default-user password, shared by clickhouse (source) + Snuba (refs).
# clickhouse writes it via from_env (railway/clickhouse/Dockerfile):
#   clickhouse:                CLICKHOUSE_PASSWORD=${{ secret(32) }}
#   snuba-api / snuba-errors:  CLICKHOUSE_PASSWORD=${{ clickhouse.CLICKHOUSE_PASSWORD }}
CLICKHOUSE_PASSWORD=${{ secret(32) }}

# ---- Public URL (sentry-web) — REQUIRED for browser login --------------------
# Since Django 4, unset => "CSRF Validation Failed" on sign-in. Reference the
# domain attached to the gateway so it tracks the deploy's real URL:
SENTRY_URL_PREFIX=https://${{gateway.RAILWAY_PUBLIC_DOMAIN}}

# ---- Relay keypair — REQUIRED for ingestion ----------------------------------
# The one thing secret() can't generate: a MATCHED keypair (sentry-web must trust
# the relay's PUBLIC key). Ship a fixed keypair as template defaults, or generate:
#   docker run --rm ghcr.io/getsentry/relay credentials generate --stdout
# 1) whole JSON       -> RELAY_CREDENTIALS_JSON    on the sentry-relay service
# 2) its "public_key" -> SENTRY_RELAY_WHITELIST_PK on the sentry-web service
RELAY_CREDENTIALS_JSON={"secret_key":"...","public_key":"...","id":"..."}
SENTRY_RELAY_WHITELIST_PK=<relay public_key; must match the JSON above>

# ---- First admin (optional; sentry-web) --------------------------------------
# If both are set, the sentry-web pre-deploy creates this superuser (idempotent).
# Leave unset to create the first admin via the web setup screen on first visit.
# SENTRY_ADMIN_EMAIL=admin@example.com
# SENTRY_ADMIN_PASSWORD=CHANGE_ME

# ---- Retention (optional) ----------------------------------------------------
SENTRY_EVENT_RETENTION_DAYS=90

# ---- Static peer hostnames (already set; change only if you rename a service) -
# Railway private DNS = <service-name>.railway.internal.
# SNUBA=http://snuba-api.railway.internal:1218
# CLICKHOUSE_HOST=clickhouse.railway.internal
# DEFAULT_BROKERS=kafka.railway.internal:9092
# REDIS_HOST=redis.railway.internal

# ---- Bootstrap wait tuning (optional; pre-deploy) ----------------------------
# The pre-deploy scripts wait for the data plane before migrating.
# BOOTSTRAP_WAIT_FOR=postgres.railway.internal:5432 kafka.railway.internal:9092 redis.railway.internal:6379
# BOOTSTRAP_WAIT_TIMEOUT=300

# ---- Mail (optional; point at an external SMTP provider) ---------------------
# The lean template ships no SMTP service; set these to send email/alerts.
# SENTRY_SMTP_HOST=
# SENTRY_SMTP_PORT=587
# SENTRY_SMTP_USERNAME=
# SENTRY_SMTP_PASSWORD=
