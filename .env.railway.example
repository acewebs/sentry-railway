# Sentry on Railway — environment variables
#
# Copy the values you need into Railway. Put anything shared across services
# (secret key, host/broker names) in a Railway SHARED variable so every service
# sees the same value. See docs/RAILWAY.md for which service needs what.

# ---- Image tags (pin these; "nightly" is a moving target) --------------------
SENTRY_IMAGE=ghcr.io/getsentry/sentry:nightly
SNUBA_IMAGE=ghcr.io/getsentry/snuba:nightly
RELAY_IMAGE=ghcr.io/getsentry/relay:nightly
SYMBOLICATOR_IMAGE=ghcr.io/getsentry/symbolicator:nightly
VROOM_IMAGE=ghcr.io/getsentry/vroom:nightly
TASKBROKER_IMAGE=ghcr.io/getsentry/taskbroker:nightly
UPTIME_CHECKER_IMAGE=ghcr.io/getsentry/uptime-checker:nightly
LAUNCHPAD_IMAGE=ghcr.io/getsentry/launchpad:nightly

# ---- Core secrets (generate once; NEVER commit real values) ------------------
# Django secret key (set on sentry-web). On Railway make it a generated variable:
#   SENTRY_SYSTEM_SECRET_KEY=${{ secret(50) }}
# Locally generate with: sentry config generate-secret-key
SENTRY_SYSTEM_SECRET_KEY=CHANGE_ME_generate_a_50_char_secret
# Relay <-> Sentry shared secret (see install/ensure-relay-credentials.sh)
LAUNCHPAD_RPC_SHARED_SECRET=CHANGE_ME

# ---- Public URL (set on sentry-web) — REQUIRED for browser login -------------------
# Sentry needs its public https URL for absolute links AND, since Django 4, to
# trust the login form's Origin (unset => "CSRF Validation Failed" on sign-in).
# Point it at the domain attached to the gateway via a Railway variable reference:
SENTRY_URL_PREFIX=https://${{gateway.RAILWAY_PUBLIC_DOMAIN}}

# ---- Relay credentials (per deploy) — REQUIRED for ingestion ----------------
# Generate ONE keypair and wire both halves so sentry-web trusts this relay:
#   docker run --rm ghcr.io/getsentry/relay:nightly credentials generate --stdout
# 1) whole JSON -> RELAY_CREDENTIALS_JSON on the `relay` service (written to
#    credentials.json at start by railway/relay/entrypoint.sh).
# 2) its "public_key" -> SENTRY_RELAY_WHITELIST_PK on the `sentry-web` service.
RELAY_CREDENTIALS_JSON={"secret_key":"...","public_key":"...","id":"..."}
SENTRY_RELAY_WHITELIST_PK=CHANGE_ME_relay_public_key

# ---- ClickHouse password (per deploy) — set on clickhouse + Snuba services ----
# ClickHouse's default user reads this at runtime (railway/clickhouse/Dockerfile
# writes it via from_env). The Snuba services that talk to ClickHouse must present
# the SAME value. On Railway auto-generate it on clickhouse and reference it:
#   clickhouse:                CLICKHOUSE_PASSWORD=${{ secret(32) }}
#   snuba-api / snuba-errors:  CLICKHOUSE_PASSWORD=${{ clickhouse.CLICKHOUSE_PASSWORD }}
CLICKHOUSE_PASSWORD=CHANGE_ME_generate_a_clickhouse_password

# ---- Bootstrap admin (optional; set on the `sentry-web` service) --------------------
# If both are set, the sentry-web pre-deploy bootstrap creates this superuser
# (idempotent). Leave unset to create the first admin via the web setup screen.
# SENTRY_ADMIN_EMAIL=admin@example.com
# SENTRY_ADMIN_PASSWORD=CHANGE_ME

# ---- Bootstrap wait tuning (pre-deploy; sensible defaults) -------------------
# The pre-deploy scripts wait for the data plane before migrating. Override the
# targets (space-separated host:port) or the timeout only if you renamed services.
# BOOTSTRAP_WAIT_FOR=postgres.railway.internal:5432 kafka.railway.internal:9092 redis.railway.internal:6379
# BOOTSTRAP_WAIT_TIMEOUT=300

# ---- Sentry behaviour --------------------------------------------------------
SENTRY_EVENT_RETENTION_DAYS=90
SENTRY_BIND=9000
SENTRY_TASKWORKER_CONCURRENCY=4
COMPOSE_PROFILES=feature-complete

# ---- Private-network peer hostnames ------------------------------------------
# On Railway, name services to match these OR override to *.railway.internal.
SNUBA=http://snuba-api:1218
VROOM=http://vroom:8085
CLICKHOUSE_HOST=clickhouse
DEFAULT_BROKERS=kafka:9092
REDIS_HOST=redis

# ---- Mail (prefer an external SMTP provider over the bundled smtp service) ----
SENTRY_MAIL_HOST=
# SENTRY_SMTP_HOST=
# SENTRY_SMTP_PORT=587
# SENTRY_SMTP_USERNAME=
# SENTRY_SMTP_PASSWORD=

# ---- Object storage ----------------------------------------------------------
# Recommended: point at external S3-compatible storage and drop the seaweedfs
# service (Railway has no managed object store). Configure the filestore backend
# in sentry/config.yml accordingly.

# ---- Healthcheck tuning (upstream defaults) ----------------------------------
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=1m30s
HEALTHCHECK_RETRIES=10
HEALTHCHECK_START_PERIOD=10s
HEALTHCHECK_FILE_INTERVAL=60s
HEALTHCHECK_FILE_TIMEOUT=10s
HEALTHCHECK_FILE_RETRIES=3
HEALTHCHECK_FILE_START_PERIOD=600s
