# clickhouse — template variables
# Source of the shared ClickHouse password: generate once per deploy, others reference it.

CLICKHOUSE_PASSWORD=${{ secret(32) }}
# Password for ClickHouse's default user; auto-generated per deploy, written into the server config via from_env and referenced by the Snuba services.
MAX_MEMORY_USAGE_RATIO=0.3
# Fraction of container RAM ClickHouse may use for a single query (Altinity image tuning).
RAILWAY_DOCKERFILE_PATH=railway/clickhouse/Dockerfile
# Path to this service's Dockerfile in the repo.
