# snuba-api — template variables
# Snuba HTTP API (port 1218) + bootstrap (migrations) via preDeployCommand.

REDIS_HOST=${{ redis.RAILWAY_PRIVATE_DOMAIN }}
# Hostname of the Redis service Snuba uses for state/caches.
SNUBA_SETTINGS=self_hosted
# Snuba settings profile; self_hosted matches the single-node Sentry stack.
CLICKHOUSE_HOST=${{ clickhouse.RAILWAY_PRIVATE_DOMAIN }}
# Hostname of the ClickHouse service Snuba queries.
DEFAULT_BROKERS=${{ kafka.RAILWAY_PRIVATE_DOMAIN }}:9092
# Kafka bootstrap server (host:port) Snuba consumers connect to.
UWSGI_MAX_REQUESTS=10000
# Recycle each uWSGI worker after this many requests (memory-leak guard).
UWSGI_DISABLE_LOGGING=true
# Silence per-request uWSGI access logs to reduce noise.
CLICKHOUSE_PASSWORD=${{ clickhouse.CLICKHOUSE_PASSWORD }}
# ClickHouse default-user password; references the value generated on the clickhouse service.
RAILWAY_DOCKERFILE_PATH=railway/snuba-api/Dockerfile
# Path to this service's Dockerfile in the repo.
