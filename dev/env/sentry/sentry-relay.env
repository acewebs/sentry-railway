# sentry-relay — template variables
# Ingestion gateway SDKs talk to. Upstream (sentry-web), kafka, redis hosts baked into
# relay/config.yml; entrypoint writes credentials.json from RELAY_CREDENTIALS_JSON.
# The keypair is a fixed template default — placeholder here, never real in git.

RELAY_CREDENTIALS_JSON={"secret_key":"<...>","public_key":"<matches sentry-web SENTRY_RELAY_WHITELIST_PK>","id":"<...>"}
# Relay's matched keypair (secret+public+id); fixed template default, public_key must match sentry-web's whitelist.
RAILWAY_DOCKERFILE_PATH=railway/relay/Dockerfile
# Path to this service's Dockerfile in the repo.
