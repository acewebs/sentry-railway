# sentry-web — template variables
# Django app: UI, REST API, relay-facing endpoints. DB/redis/kafka/clickhouse hosts
# are baked into the Sentry config; only deploy-specific values live here.

SENTRY_CONF=/etc/sentry
# Directory holding sentry.conf.py / config.yml inside the image.
SENTRY_EVENT_RETENTION_DAYS=90
# Days to retain events before the cleanup job deletes them.
SENTRY_SYSTEM_SECRET_KEY=${{ secret(50) }}
# Django SECRET_KEY; auto-generated per deploy, shared with sentry-workers.
SENTRY_URL_PREFIX=https://${{ gateway.RAILWAY_PUBLIC_DOMAIN }}
# Public base URL; references the gateway's public domain (required for browser login/CSRF).
SNUBA=http://${{ snuba-api.RAILWAY_PRIVATE_DOMAIN }}:1218
# URL of the Snuba API service (ClickHouse query layer).
SENTRY_RELAY_WHITELIST_PK=<relay public_key — matched pair with sentry-relay>
# Relay's public key; must match the public_key in sentry-relay's RELAY_CREDENTIALS_JSON. Baked template default.
RAILWAY_DOCKERFILE_PATH=railway/sentry/Dockerfile
# Path to this service's Dockerfile in the repo.
