# kafka — template variables
# Single-node KRaft broker; persists to kafka-volume at /var/lib/kafka/data.
# KAFKA_ADVERTISED_LISTENERS self-references ${{ RAILWAY_PRIVATE_DOMAIN }} so it tracks renames.

CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# KRaft cluster identifier; a fixed constant (must stay invariant for the volume's life).
CONFLUENT_SUPPORT_METRICS_ENABLE=false
# Disable Confluent telemetry/metrics reporting.
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://127.0.0.1:29092,INTERNAL://${{ RAILWAY_PRIVATE_DOMAIN }}:9093,EXTERNAL://${{ RAILWAY_PRIVATE_DOMAIN }}:9092
# Addresses Kafka advertises to clients; self-references this service's private domain.
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
# Allow Kafka to auto-create topics on first use.
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
# Listener name used for the KRaft controller.
KAFKA_CONTROLLER_QUORUM_VOTERS=1001@127.0.0.1:29093
# KRaft controller quorum (single node: this broker).
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
# Listener used for inter-broker traffic.
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:29092,INTERNAL://0.0.0.0:9093,EXTERNAL://0.0.0.0:9092,CONTROLLER://0.0.0.0:29093
# Sockets Kafka binds locally (broker + controller listeners).
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
# Security protocol per listener (all PLAINTEXT on the private network).
KAFKA_LOG4J_ROOT_LOGLEVEL=WARN
# Kafka broker root log level.
KAFKA_LOG_DIRS=/var/lib/kafka/data/logs
# Directory (inside the volume) for Kafka log segments.
KAFKA_LOG_RETENTION_HOURS=24
# How long Kafka retains messages before deletion.
KAFKA_MAX_REQUEST_SIZE=50000000
# Max request size in bytes (raised for large event payloads).
KAFKA_MESSAGE_MAX_BYTES=50000000
# Max message size in bytes (raised for large event payloads).
KAFKA_NODE_ID=1001
# KRaft node id for this broker.
KAFKA_OFFSETS_TOPIC_NUM_PARTITIONS=1
# Partitions for the internal consumer-offsets topic (1 for single node).
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
# Replication factor for internal topics (1 for single node).
KAFKA_PROCESS_ROLES=broker,controller
# KRaft roles this node runs (broker + controller).
RAILWAY_DOCKERFILE_PATH=railway/kafka/Dockerfile
# Path to this service's Dockerfile in the repo.
