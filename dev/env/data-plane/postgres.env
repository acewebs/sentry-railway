# postgres — template variables
# Stock postgres image (no Dockerfile). Trust auth on the private network, default
# user/db = postgres. Persists to postgres-volume at /var/lib/postgresql/data.

PGDATA=/var/lib/postgresql/data/pgdata
# Directory inside the volume where Postgres stores its data files.
POSTGRES_HOST_AUTH_METHOD=trust
# Auth mode for the stock image; trust = no password (safe: private network only).
